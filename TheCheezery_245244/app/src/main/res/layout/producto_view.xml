<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:paddingHorizontal="25dp"
             android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/producto_img"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/caramelfrap"
        android:layout_margin="@dimen/input_margin"
    />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="3"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:textSize="20sp"
            android:id="@+id/producto_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/caramel_frap"
            android:textColor="@color/nombre"
            android:fontFamily="sans-serif-condensed"
        />

        <TextView
            android:id="@+id/producto_desc"
            android:layout_width="match_parent"
            android:textSize="8sp"
            android:layout_height="wrap_content"
            android:text="@string/descripci_n_del_producto"
            android:textColor="@color/purple_gray"
            android:fontFamily="sans-serif-light"
        />

    </LinearLayout>

    <TextView
        android:id="@+id/producto_precio"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:textColor="@color/precio"
        android:gravity="center"
        android:layout_height="match_parent"
        android:text="@string/precio"
        android:textSize="19sp"
        android:textStyle="bold"
    />

</LinearLayout>